```gitignore
# Java compiled files
*.class

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar

# Logs
*.log

# IDE files
.idea/
*.iml
.vscode/

# macOS
.DS_Store

# Environment / secrets
.env
.env.*

# Java package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*
replay_pid*

# Spring Boot configuration
**/application.properties
```
